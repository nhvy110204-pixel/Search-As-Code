      "id": 2,
      "title": "API Request Latency (Avg over 5m)",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "Prometheus"
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "Prometheus"
          },
          "editorMode": "code",
          "expr": "sum(rate(http_request_latency_seconds_sum[5m])) by (path_category) / sum(rate(http_request_latency_seconds_count[5m])) by (path_category)",
          "legendFormat": "{{path_category}} latency",
          "range": true,
          "refId": "A"
        }
      ]
